# Local developer credentials. One-time setup:
# - copy this file to .env.secrets (drop the .example)
# - ask a team member for the values and replace the placeholders
# - keep advancing health equity!
#
# .env.secrets is gitignored. Never commit it or paste a key into a PR,
# issue, or chat log.

# ProPublica:
PROPUBLICA_API_KEY=YOUR_API_KEY_HERE

# readme.io, for scripts/readme_recipes/sync_recipes.py:
README_API_KEY=YOUR_API_KEY_HERE
